generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  name      String?
  email     String?
  clerkId   String?
  password  String
  createdAt DateTime @default(now())

  @@index([email])
  @@index([clerkId])
}

model Teacher {
  id             String                 @id @default(cuid())
  name           String
  username       String                 @unique
  email          String?
  clerkId        String?
  password       String
  nip            String?                @unique
  classGroup     String                 @default("A") // "A", "B", atau "C"
  profileImage   String? // Base64 string for avatar
  nickname       String?
  activeTheme    String                 @default("default")
  unlockedThemes String[]               @default(["default"])
  activeTitle    String?
  unlockedTitles String[]               @default([])
  avatarUnlocked Boolean                @default(true) // Status apakah Avatar Pass sudah dibeli (Guru default true)
  avatarConfig   String?
  createdAt      DateTime               @default(now())
  lastActive     DateTime?
  referenceNotes TeacherReferenceNote[]

  @@index([email])
  @@index([clerkId])
}

model Student {
  id              String            @id @default(cuid())
  name            String
  gender          String // "L" atau "P"
  birthPlace      String?
  birthDate       DateTime?
  studentCode     String            @unique // Format: 2312026xxx
  username        String            @unique
  email           String?
  clerkId         String?
  password        String
  classGroup      String            @default("A") // "A", "B", atau "C"
  profileImage    String? // Base64 string for avatar
  nickname        String? // Gamertag/Display name
  spentPoints     Int               @default(0)
  activeTheme     String            @default("default")
  unlockedThemes  String[]          @default(["default"])
  activeTitle     String? // Titel yang sedang digunakan (misal "Sang Jagoan")
  unlockedTitles  String[]          @default([]) // Titel yang sudah dibeli
  avatarUnlocked  Boolean           @default(false) // Status apakah Avatar Pass sudah dibeli
  avatarConfig    String? // JSON string untuk menyimpan konfigurasi wajah, mulut, mata, dll
  faceDescriptor  Json? // Array 128 angka float embedding fitur wajah
  facePhoto       String? // Thumbnail foto wajah terdaftar (Base64)
  faceEnrolledAt  DateTime? // Waktu pendaftaran wajah
  attendances     Attendance[]
  studentProgress StudentProgress[]
  quizAttempts    QuizAttempt[]
  createdAt       DateTime          @default(now())
  lastActive      DateTime?

  @@index([email])
  @@index([clerkId])
}

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    String // "Hadir", "Izin", "Absen"
  timestamp DateTime @default(now())
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  createdAt DateTime @default(now())
}

model CourseResource {
  id           String            @id @default(cuid())
  title        String
  type         String // "Text", "Photo", "Video", "Audio"
  description  String?
  driveUrl     String
  durationMins Int               @default(10)
  orderIndex   Int               @default(0) // Untuk mengurutkan materi
  createdAt    DateTime          @default(now())
  progress     StudentProgress[]
  questions    Question[]
  quizAttempts QuizAttempt[]
}

model Question {
  id            String         @id @default(cuid())
  resourceId    String
  resource      CourseResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  text          String
  optionA       String
  optionB       String
  optionC       String
  correctAnswer String // "A", "B", or "C"
}

model QuizAttempt {
  id         String         @id @default(cuid())
  studentId  String
  student    Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  resourceId String
  resource   CourseResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  score      Int
  passed     Boolean
  createdAt  DateTime       @default(now())
}

model StudentProgress {
  id          String         @id @default(cuid())
  studentId   String
  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  resourceId  String
  resource    CourseResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  completedAt DateTime       @default(now())

  @@unique([studentId, resourceId])
}

model TeacherReference {
  id        String                 @id @default(cuid())
  title     String
  driveUrl  String
  fileType  String
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  notes     TeacherReferenceNote[]
}

model TeacherReferenceNote {
  id          String           @id @default(cuid())
  referenceId String
  teacherId   String
  content     String           @default("")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  reference   TeacherReference @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  teacher     Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([referenceId, teacherId])
  @@index([teacherId])
}

model TemanMuConversation {
  id        String           @id @default(cuid())
  ownerId   String
  ownerRole String
  title     String           @default("Chat baru")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  messages  TemanMuMessage[]

  @@index([ownerId, ownerRole, updatedAt])
}

model TemanMuMessage {
  id             String              @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime            @default(now())
  conversation   TemanMuConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AppReview {
  id        String   @id @default(cuid())
  name      String
  role      String   @default("Pengguna") // "Wali Murid", "Guru", "Siswa", "Masyarakat"
  rating    Int      @default(5)
  comment   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model AppDownloadLog {
  id        String   @id @default(cuid())
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
