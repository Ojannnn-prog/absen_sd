generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
}

model Student {
  id          String       @id @default(cuid())
  name        String
  gender      String       // "L" atau "P"
  birthPlace  String?
  birthDate   DateTime?
  studentCode String       @unique // Format: 2312026xxx
  username       String       @unique
  password       String
  profileImage   String?      // Base64 string for avatar
  nickname       String?      // Gamertag/Display name
  spentPoints    Int          @default(0)
  activeTheme    String       @default("default")
  unlockedThemes  String[]          @default(["default"])
  attendances     Attendance[]
  studentProgress StudentProgress[]
  quizAttempts    QuizAttempt[]
  createdAt       DateTime          @default(now())
  lastActive      DateTime?
}

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    String   // "Hadir", "Izin", "Absen"
  timestamp DateTime @default(now())
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  createdAt DateTime @default(now())
}

model CourseResource {
  id           String            @id @default(cuid())
  title        String
  type         String            // "Text", "Photo", "Video", "Audio"
  description  String?
  driveUrl     String
  durationMins Int               @default(10)
  orderIndex   Int               @default(0) // Untuk mengurutkan materi
  createdAt    DateTime          @default(now())
  progress     StudentProgress[]
  questions    Question[]
  quizAttempts QuizAttempt[]
}

model Question {
  id            String         @id @default(cuid())
  resourceId    String
  resource      CourseResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  text          String
  optionA       String
  optionB       String
  optionC       String
  correctAnswer String         // "A", "B", or "C"
}

model QuizAttempt {
  id         String         @id @default(cuid())
  studentId  String
  student    Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  resourceId String
  resource   CourseResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  score      Int
  passed     Boolean
  createdAt  DateTime       @default(now())
}

model StudentProgress {
  id           String         @id @default(cuid())
  studentId    String
  student      Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  resourceId   String
  resource     CourseResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  completedAt  DateTime       @default(now())

  @@unique([studentId, resourceId])
}
